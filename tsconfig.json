{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "skipLibCheck": true,

    /* The services are still plain .js; let the .tsx files import them. */
    "allowJs": true,
    "checkJs": false,

    "strict": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
